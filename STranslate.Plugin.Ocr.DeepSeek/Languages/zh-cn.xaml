<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_Url">接口</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_Url_Description">配置 DeepSeek API 服务地址，留空则使用官方地址 https://api.deepseek.com&#x0a;地址不以 /tools/ocr 结尾时会自动补全，如 https://api.deepseek.com 实际请求 https://api.deepseek.com/v1/tools/ocr&#x0a;以 # 结尾则强制使用填写的地址，不做补全</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_ApiKey">密钥</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_ApiKey_Placeholder">请输入密钥</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_ApiKey_Description">输入您的 DeepSeek API 密钥</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_Mode">识别模式</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_Mode_Description">「TextRecognition」为文字识别；「RichLayoutRecognition」为版面识别，会返回文字坐标，用作图片翻译的 OCR 服务时需要选择它</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_Official">获取密钥</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_Official_Description">在 DeepSeek 开放平台创建 API 密钥</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_Validate_Description">发送一张测试图片验证配置，按识别 1 页计费</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_ApiKeyMissing">请先填写 DeepSeek API 密钥</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_DeepSeek_Truncated">识别输出达到长度上限，结果可能不完整</sys:String>

</ResourceDictionary>
