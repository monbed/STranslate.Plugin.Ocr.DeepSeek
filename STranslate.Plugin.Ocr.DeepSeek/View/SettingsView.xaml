<UserControl
    x:Class="STranslate.Plugin.Ocr.DeepSeek.View.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plugin="clr-namespace:STranslate.Plugin;assembly=STranslate.Plugin"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:STranslate.Plugin.Ocr.DeepSeek.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ikw:SimpleStackPanel Spacing="12">
        <!--  API URL 配置  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_DeepSeek_Url_Description}" Header="{DynamicResource STranslate_Plugin_Ocr_DeepSeek_Url}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Globe_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ikw:SimpleStackPanel Orientation="Vertical" Spacing="8">
                <TextBox
                    MinWidth="300"
                    ui:ControlHelper.PlaceholderText="https://api.deepseek.com"
                    Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    FontSize="{DynamicResource STControlFontSize12}"
                    Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemFillColorNeutralBrushKey}}"
                    Text="{Binding FinalUrl}" />
            </ikw:SimpleStackPanel>
        </ui:SettingsCard>

        <!--  API Key 配置  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_DeepSeek_ApiKey_Description}" Header="{DynamicResource STranslate_Plugin_Ocr_DeepSeek_ApiKey}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Key_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <PasswordBox
                MinWidth="300"
                plugin:PasswordBoxAssistant.Attach="True"
                plugin:PasswordBoxAssistant.Password="{Binding ApiKey}"
                ui:ControlHelper.PlaceholderText="{DynamicResource STranslate_Plugin_Ocr_DeepSeek_ApiKey_Placeholder}" />
        </ui:SettingsCard>

        <!--  识别模式（接口的 purpose 参数）  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_DeepSeek_Mode_Description}" Header="{DynamicResource STranslate_Plugin_Ocr_DeepSeek_Mode}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.TaskListSquareLtr_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" />
        </ui:SettingsCard>

        <!--  获取密钥  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_DeepSeek_Official_Description}" Header="{DynamicResource STranslate_Plugin_Ocr_DeepSeek_Official}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.WebAsset_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:HyperlinkButton Content="https://platform.deepseek.com/api_keys" NavigateUri="https://platform.deepseek.com/api_keys" />
        </ui:SettingsCard>

        <!--  连接验证  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_DeepSeek_Validate_Description}" Header="{DynamicResource PluginTranslateValidate}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.CheckmarkCircle_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>

            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{Binding ValidateCommand}" Style="{StaticResource AccentButtonStyle}">
                    <ui:IconAndText Content="{DynamicResource PluginTranslateValidate}" Icon="{x:Static ui:FluentSystemIcons.Play_24_Regular}" />
                </Button>

                <!--  验证结果显示  -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="Background" Value="{DynamicResource {x:Static ui:ThemeKeys.SystemFillColorAttentionBackgroundBrushKey}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ValidateResult}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource STControlFontSize12}"
                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                        Text="{Binding ValidateResult}" />
                </Border>
            </ikw:SimpleStackPanel>
        </ui:SettingsCard>
    </ikw:SimpleStackPanel>
</UserControl>
